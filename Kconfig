config ZMK_DONGLE_SCREEN_ENGINE
    bool "Dongle Theme engine"
    default y if SHIELD_DONGLE_SCREEN_HOST
    select ZMK_DONGLE_SCREEN_DIRECT_RGB565

config ZMK_DONGLE_SCREEN_FPS
    int "Theme animation deadline frequency (not a guaranteed physical refresh rate)"
    default 60
    range 1 60
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_OPTIMIZE_SPEED
    bool "Favor renderer throughput over minimum firmware size"
    default n
    depends on ZMK_DONGLE_SCREEN_ENGINE
    help
      Compile Engine raster and transport code with -O3. Enable only after
      checking the final firmware map against the board's Flash budget.
      Use Q8 distance and Q15 arc coverage with a symmetric distance table.

config ZMK_DONGLE_SCREEN_MAX_THROUGHPUT
    bool "Immediately continue an over-budget animation"
    default n
    depends on ZMK_DONGLE_SCREEN_ENGINE
    help
      When a completed animation frame already exceeds the configured frame
      period, yield the display queue for 1 ms and render the next frame
      instead of waiting for another FPS grid boundary. Explicit Theme
      deadlines remain authoritative. This does not alter Theme pixels or
      animation time and is intended for measured slow themes.

config ZMK_DONGLE_SCREEN_DONGLE_BATTERY
    bool "The dongle has a physical battery (otherwise show only split 0/1)"
    default n
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_BRIGHTNESS
    int "Display backlight percent"
    default 40
    range 0 100
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_DIRECT_RGB565
    bool "Send ABI 1.2+ RGB565 regions directly through the display driver"
    default y
    depends on ZMK_DONGLE_SCREEN_ENGINE
    help
      Required by Theme ABI 1.2 and later. LVGL retains screen lifecycle ownership while
      the Engine renders bounded strips directly through the display driver.

config ZMK_DONGLE_SCREEN_FULL_FRAMEBUFFER
    bool "Compose and present a full RGB565 framebuffer"
    default n
    depends on ZMK_DONGLE_SCREEN_DIRECT_RGB565
    help
      Retain one 280x240 RGB565 frame for themes whose large moving geometry
      needs one complete draw. The host hashes 16x16 tiles and sends only
      changed packed rectangles. This uses 139792 bytes RAM: 134400 bytes for
      pixels, 4096 bytes for transfer scratch and 1296 bytes for tile hashes.

config ZMK_DONGLE_SCREEN_FILTER_CRT
    bool "Apply the lightweight CRT glass filter"
    default n
    depends on ZMK_DONGLE_SCREEN_ENGINE
    help
      Add asymmetric non-linear edge darkening, rounded black corners and a
      weak top highlight after Theme drawing. This performs no barrel warp and
      allocates no additional framebuffer.

config ZMK_DONGLE_SCREEN_FILTER_CRT_CORNER_RADIUS
    int "CRT filter inner corner radius (px)"
    default 24
    range 1 120
    depends on ZMK_DONGLE_SCREEN_FILTER_CRT
    help
      Radius of the filter's inner black glass corners in physical panel
      pixels. The value is clamped to half of the shortest screen side.

config ZMK_DONGLE_SCREEN_STRIP_PIXELS
    int "Maximum RGB565 pixels in the firmware render strip"
    default 4480
    range 4480 31360
    depends on ZMK_DONGLE_SCREEN_DIRECT_RGB565
    help
      Bounds static render RAM independently of display area. 4480 pixels are
      sixteen full rows at 280 pixels wide and require 8960 bytes. 31360
      pixels hold 112 rows (62720 bytes), below nRF EasyDMA's 65535-byte limit.

config ZMK_DONGLE_SCREEN_REGION_TILE_HASH
    bool "Pack changed tiles during continuous region animation"
    default n
    depends on ZMK_DONGLE_SCREEN_DIRECT_RGB565 && !ZMK_DONGLE_SCREEN_FULL_FRAMEBUFFER
    help
      Hash and pack changed 16x16 tiles for continuous region animation.
      This lowers payload but creates more LCD windows. Disabled mode sends
      each rendered strip in order for stronger spatial coherence.

config ZMK_DONGLE_SCREEN_STARTUP_DELAY_MS
    int "Black screen settling time before the first theme frame (ms)"
    default 0
    range 0 5000
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_SPLASH_MS
    int "Theme splash duration (ms)"
    default 1000
    range 0 5000
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_DIAL_REVEAL_MS
    int "Theme reveal-stage duration (ms)"
    default 500
    range 0 5000
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_DISTANCE_LUT
    bool "Use exact float distance lookup (64 KiB flash, no extra framebuffer)"
    default n
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_PACKED_RECTS
    bool "Pack exact dirty rectangles for display transport (4 KiB scratch)"
    default y
    depends on ZMK_DONGLE_SCREEN_DIRECT_RGB565
    help
      Compatibility option retained for existing configurations. ABI 1.2+
      always renders exact dirty rectangles into the bounded strip buffer.
