config ZMK_DONGLE_SCREEN_ENGINE
    bool "Dongle Theme engine"
    default y if SHIELD_DONGLE_SCREEN_HOST
    select ZMK_DONGLE_SCREEN_DIRECT_RGB565

config ZMK_DONGLE_SCREEN_FPS
    int "Theme animation deadline frequency (not a guaranteed physical refresh rate)"
    default 60
    range 1 60
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_DONGLE_BATTERY
    bool "The dongle has a physical battery (otherwise show only split 0/1)"
    default n
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_BRIGHTNESS
    int "Display backlight percent"
    default 40
    range 0 100
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_DIRECT_RGB565
    bool "Send ABI 1.2+ RGB565 regions directly through the display driver"
    default y
    depends on ZMK_DONGLE_SCREEN_ENGINE
    help
      Required by Theme ABI 1.2 and later. LVGL retains screen lifecycle ownership while
      the Engine renders bounded strips directly through the display driver.

config ZMK_DONGLE_SCREEN_FULL_FRAMEBUFFER
    bool "Compose and present a full RGB565 framebuffer"
    default n
    depends on ZMK_DONGLE_SCREEN_DIRECT_RGB565
    help
      Retain one 280x240 RGB565 frame for themes whose large moving geometry
      needs one complete draw. The host hashes 16x16 tiles and sends only
      changed packed rectangles. This uses 139792 bytes RAM: 134400 bytes for
      pixels, 4096 bytes for transfer scratch and 1296 bytes for tile hashes.

config ZMK_DONGLE_SCREEN_SYNC_ANIMATION
    bool "Advance animation only after a presented frame"
    default y if ZMK_DONGLE_SCREEN_FULL_FRAMEBUFFER
    default n
    depends on ZMK_DONGLE_SCREEN_ENGINE
    help
      Keep logical animation time in step with successful display frames.
      Slow hardware preserves every intermediate animation step instead of
      skipping to wall-clock time; wall-clock duration consequently stretches.

config ZMK_DONGLE_SCREEN_STRIP_PIXELS
    int "Maximum RGB565 pixels in the firmware render strip"
    default 4480
    range 4480 17920
    depends on ZMK_DONGLE_SCREEN_DIRECT_RGB565
    help
      Bounds static render RAM independently of display area. 4480 pixels are
      sixteen full rows at 280 pixels wide and require 8960 bytes; the
      16-row minimum keeps region hashes and transfer tiles aligned. 17920
      pixels hold 64 rows (35840 bytes), below nRF EasyDMA's 65535-byte limit.

config ZMK_DONGLE_SCREEN_STARTUP_DELAY_MS
    int "Black screen settling time before the first theme frame (ms)"
    default 0
    range 0 5000
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_SPLASH_MS
    int "Theme splash duration (ms)"
    default 1000
    range 0 5000
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_DIAL_REVEAL_MS
    int "Theme reveal-stage duration (ms)"
    default 500
    range 0 5000
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_DISTANCE_LUT
    bool "Use exact float distance lookup (64 KiB flash, no extra framebuffer)"
    default n
    depends on ZMK_DONGLE_SCREEN_ENGINE

config ZMK_DONGLE_SCREEN_PACKED_RECTS
    bool "Pack exact dirty rectangles for display transport (4 KiB scratch)"
    default y
    depends on ZMK_DONGLE_SCREEN_DIRECT_RGB565
    help
      Compatibility option retained for existing configurations. ABI 1.2+
      always renders exact dirty rectangles into the bounded strip buffer.
